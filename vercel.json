{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "{server.py,shared_store.py,data/example.json}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?endpoint=:path*"
    },
    {
      "source": "/mono/",
      "destination": "/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/mono",
      "destination": "/mono/",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": false
    }
  ]
}