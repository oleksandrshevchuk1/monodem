{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "{server.py,shared_store.py,identity.py,auth_config.py,data/example.json}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/mono/login.html",
      "destination": "/login.html"
    },
    {
      "source": "/admin/login.html",
      "destination": "/login.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?endpoint=:path*"
    },
    {
      "source": "/mono/",
      "destination": "/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/mono",
      "destination": "/mono/",
      "permanent": false
    },
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": false
    }
  ]
}
