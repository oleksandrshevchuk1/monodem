{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {"includeFiles": "{server.py,data/example.json}", "maxDuration": 60}
  },
  "rewrites": [{"source": "/api/:path*", "destination": "/api/index?endpoint=:path*"}],
  "headers": [{"source": "/(index.html|admin.html|sw.js)", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}]
}
